<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>RiverWatch - River Health & Pollution Intelligence Report</title>
  <style>
    body { font-family: 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #1e293b; margin: 30px; background: #ffffff; }
    .header { border-bottom: 3px solid #0284c7; padding-bottom: 15px; margin-bottom: 25px; }
    .title { font-size: 26px; font-weight: 800; color: #0f172a; margin: 0; }
    .subtitle { font-size: 14px; color: #64748b; margin-top: 5px; }
    .badge { display: inline-block; padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 700; }
    .badge-excellent { background: #dcfce7; color: #166534; }
    .badge-good { background: #e0f2fe; color: #0369a1; }
    .badge-poor { background: #fef3c7; color: #92400e; }
    .badge-very-poor { background: #ffedd5; color: #9a3412; }
    .badge-unsuitable { background: #fee2e2; color: #991b1b; }
    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 30px; }
    .kpi-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; text-align: center; }
    .kpi-val { font-size: 24px; font-weight: 800; color: #0284c7; }
    .kpi-label { font-size: 12px; text-transform: uppercase; color: #64748b; margin-top: 5px; font-weight: 600; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 30px; font-size: 13px; }
    th { background: #f1f5f9; color: #334155; font-weight: 700; text-align: left; padding: 10px; border-bottom: 2px solid #cbd5e1; }
    td { padding: 10px; border-bottom: 1px solid #e2e8f0; }
    tr:nth-child(even) { background: #f8fafc; }
    .section-title { font-size: 18px; font-weight: 700; color: #0f172a; margin-top: 30px; margin-bottom: 10px; border-left: 4px solid #0284c7; padding-left: 10px; }
    .chart-container { text-align: center; margin: 25px 0; }
    .chart-img { max-width: 100%; height: auto; border: 1px solid #e2e8f0; border-radius: 6px; }
    .footer { margin-top: 50px; border-top: 1px solid #e2e8f0; padding-top: 15px; font-size: 11px; color: #94a3b8; text-align: center; }
  </style>
</head>
<body>
  <div class="header">
    <h1 class="title">🌊 RiverWatch: River Health & Pollution Assessment</h1>
    <div class="subtitle">Generated on {{ generated_at }} | River: <strong>{{ river_name }}</strong> | Monitored Stations: {{ n_stations }}</div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-val">{{ n_samples }}</div>
      <div class="kpi-label">Total Samples</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-val">{{ mean_wqi }}</div>
      <div class="kpi-label">Mean WQI</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-val">{{ pct_class_b }}%</div>
      <div class="kpi-label">Meeting Class B</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-val">{{ top_driver }}</div>
      <div class="kpi-label">Primary Driver</div>
    </div>
  </div>

  <h2 class="section-title">1. Station Health & Sampling Priority Summary</h2>
  <table>
    <thead>
      <tr>
        <th>Rank</th>
        <th>Station ID</th>
        <th>Station Name</th>
        <th>Order</th>
        <th>Latest WQI</th>
        <th>WQI Class</th>
        <th>Priority Score</th>
        <th>Recommended Action / Reason</th>
      </tr>
    </thead>
    <tbody>
      {% for stn in stations %}
      <tr>
        <td><strong>#{{ loop.index }}</strong></td>
        <td>{{ stn.station_id }}</td>
        <td>{{ stn.station_name }}</td>
        <td>{{ stn.river_order }}</td>
        <td>{{ stn.latest_wqi or 'N/A' }}</td>
        <td>
          <span class="badge badge-{{ stn.wqi_class_slug }}">
            {{ stn.wqi_class or 'Unknown' }}
          </span>
        </td>
        <td><strong>{{ stn.priority_score or '0.0' }}</strong></td>
        <td>{{ stn.priority_reason or 'Routine monitoring' }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2 class="section-title">2. Primary Pollution Drivers Ranking</h2>
  <table>
    <thead>
      <tr>
        <th>Rank</th>
        <th>Parameter Code</th>
        <th>Driver Score</th>
        <th>PCA Contribution</th>
        <th>WQI Correlation</th>
        <th>Period Change</th>
        <th>Domain Explanation</th>
      </tr>
    </thead>
    <tbody>
      {% for d in drivers %}
      <tr>
        <td><strong>#{{ d.rank }}</strong></td>
        <td><code>{{ d.param_code }}</code></td>
        <td><strong>{{ d.combined_score }}</strong></td>
        <td>{{ d.pca_score }}</td>
        <td>{{ d.corr_score }}</td>
        <td>{{ d.change_contribution }}</td>
        <td>{{ d.explanation }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2 class="section-title">3. Long-Term Trend Insights (Mann-Kendall & Sen's Slope)</h2>
  <table>
    <thead>
      <tr>
        <th>Station ID</th>
        <th>Parameter</th>
        <th>Test</th>
        <th>Trend</th>
        <th>Interpretation</th>
        <th>Sen's Slope / Year</th>
        <th>p-Value</th>
      </tr>
    </thead>
    <tbody>
      {% for t in trends[:12] %}
      <tr>
        <td>{{ t.station_id }}</td>
        <td><code>{{ t.param_code }}</code></td>
        <td>{{ t.test_used }}</td>
        <td>{{ t.trend }}</td>
        <td>
          <span style="color: {% if t.interpretation == 'worsening' %}#ef4444{% elif t.interpretation == 'improving' %}#10b981{% else %}#64748b{% endif %}; font-weight: bold;">
            {{ t.interpretation }}
          </span>
        </td>
        <td>{{ t.sen_slope_per_year }}</td>
        <td>{{ t.p_value }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if chart_image_path %}
  <div class="chart-container">
    <h3 style="color: #475569;">Longitudinal River Degradation Profile</h3>
    <img src="{{ chart_image_path }}" class="chart-img" alt="Longitudinal Profile">
  </div>
  {% endif %}

  <div class="footer">
    RiverWatch Intelligent Water Quality Analysis System &bull; CPCB & BIS Standards Compliant &bull; Automated Environmental Audit
  </div>
</body>
</html>
